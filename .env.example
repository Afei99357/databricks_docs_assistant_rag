# Shared Databricks governance and artifact storage
RAG_DATABRICKS_PROFILE=your-profile
RAG_CATALOG=your_catalog
RAG_SCHEMA=your_schema
RAG_WAREHOUSE_ID=your_sql_warehouse_id
RAG_ARTIFACT_VOLUME=rag_artifacts

# Local retrieval embeddings. These remain Ollama-based and are independent
# from the chat/reasoning model below.
RAG_EMBEDDING_BASE_URL=http://localhost:11434
RAG_EMBEDDING_MODEL=qwen3-embedding:4b
RAG_AGENT_CANDIDATES_PER_SEARCH=10
RAG_RELEVANCE_THRESHOLD=0.35
RAG_LOCAL_TEST_USER_ID=your-test-user@example.com
# Local FAISS snapshot directory. This stays on the operator machine.
RAG_LOCAL_INDEX_DIR=/absolute/path/to/local-faiss-index

# Chat/reasoning model. This one model powers both the retrieval agent and
# grounded final answers. The provider names the server API, not the model.
# Any model served by llama.cpp, vLLM, LM Studio, or another OpenAI-compatible
# endpoint can use this configuration.
RAG_CHAT_BASE_URL=http://your-chat-host:1234/v1
RAG_CHAT_MODEL=your-chat-model
RAG_CHAT_API_KEY=local
# Optional advanced override for a different retrieval-agent model:
# RAG_AGENT_BASE_URL=http://host:1234/v1
# RAG_AGENT_MODEL=another-tool-model
# RAG_AGENT_API_KEY=local

# Databricks App model, snapshot build, and deployment
RAG_DATABRICKS_EMBEDDING_ENDPOINT=databricks-qwen3-embedding-0-6b
RAG_DATABRICKS_CHAT_ENDPOINT=databricks-claude-sonnet-4-5

# Databricks App deployment, used by the app-* and deploy-code just recipes.
# RAG_APP_SOURCE_PATH is the workspace path the Bundle deployer uploads to.
RAG_APP_NAME=databricks-docs-rag-dev
RAG_APP_SOURCE_PATH=/Workspace/Users/your-email@example.com/.bundle/databricks-docs-rag/dev/files
