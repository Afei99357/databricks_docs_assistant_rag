# Databricks governance and artifact storage
RAG_DATABRICKS_PROFILE=your-profile
RAG_CATALOG=your_catalog
RAG_SCHEMA=your_schema
RAG_WAREHOUSE_ID=your_sql_warehouse_id
RAG_ARTIFACT_VOLUME=rag_artifacts

# Retrieval
RAG_EMBEDDING_MODEL=qwen3-embedding:4b
RAG_RETRIEVAL_TOP_K=15
RAG_RELEVANCE_THRESHOLD=0.35

# Answer generation (server configuration only; never exposed in the UI)
ANSWER_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:latest
DATABRICKS_CHAT_ENDPOINT=databricks-gpt-oss-20b
